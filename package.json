{
  "name": "kucharska-kniha",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Rodinná kuchárska kniha – recepty, jedálniček, nákupný zoznam",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/build-extension.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-extension.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kucharska-kniha-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kucharska-kniha-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@tanstack/vue-query": "^5.104.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "ulidx": "^2.4.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/runner": "~4.1",
    "@vitest/snapshot": "~4.1",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "~4.1",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.147.0"
  }
}
